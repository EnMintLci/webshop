@model IEnumerable<Webshop.Models.Product>



@{
    ViewData["Title"] = "Products";
}

<!-- FULL-WIDTH HERO (outside container) -->
<section class="hero-carousel">
    <div id="productHeroCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">

            <div class="carousel-item active">
                <img src="/images/heros/haromszog.jpg" class="d-block w-100" alt="Hero 1">
                <div class="carousel-caption">
                    <h1>New Collection</h1>
                    <p>Clean. Modern. Simple.</p>
                </div>
            </div>

            <div class="carousel-item">
                <img src="/images/heros/haromszog.jpg" 
                class="d-block w-100" 
                alt="Hero 2">
                <div class="carousel-caption">
                    <h1>Minimal Style</h1>
                    <p>Designed for everyday life</p>
                </div>
            </div>

            <div class="carousel-item">
                <img src="/images/heros/haromszog.jpg" class="d-block w-100" alt="Hero 3">
                <div class="carousel-caption">
                    <h1>Built to Last</h1>
                    <p>Quality over everything</p>
                </div>
            </div>

        </div>

        <button class="carousel-control-prev" type="button"
                data-bs-target="#productHeroCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>

        <button class="carousel-control-next" type="button"
                data-bs-target="#productHeroCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>
</section>



<div class="row g-4">
    @foreach (var product in Model)
    {
		<div class="col-sm-6 col-md-4 col-lg-3">
            <a asp-controller="Products"
               asp-action="ViewProduct"
               asp-route-id="@product.Id"
               class="text-decoration-none text-dark">

				<div class="card product-card">
					

						@{
							string imageSrc = "/images/products/no_image.jpg";
                            var urls = product.ProductImages;


                        @if (urls != null && urls.Any())
								{
                                    var firstImage = product.ProductImages.FirstOrDefault();
									imageSrc =  @firstImage.ImageUrl;
								}
							else{}
						}

						<img src="@imageSrc"
							 class="product-card-img"
							 alt="@product.Name"
							  />


						<div class="card-body">
							<h5 class="card-title">@product.Name</h5>
							<p class="card-text">@product.Price Ft</p>
						</div>
					
                </div>

            </a>
            
        </div>
    }
</div>


