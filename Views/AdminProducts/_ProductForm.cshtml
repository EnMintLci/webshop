@model ProductVM

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Price" class="form-label"></label>
    <input asp-for="Price" class="form-control" />
</div>

<div class="mb-3">
    <label asp-for="Sex" class="form-label"></label>
    <select asp-for="Sex"
            asp-items="Html.GetEnumSelectList<Sex>()"
            class="form-select">
    </select>
</div>

@* <div class="mb-3">
    <label asp-for="Size" class="form-label"></label>
    <select asp-for="Size"
            asp-items="Html.GetEnumSelectList<Size>()"
            class="form-select">
    </select>
</div> *@
<div class="mb-3">
    <label class="form-label">Image filenames</label>
    <input asp-for="ImageUrls"
           class="form-control"
           placeholder="shirt1.jpg;shirt2.jpg" />
    <small class="text-muted">
        Stored in wwwroot/images/products/
    </small>
</div>
@foreach (var size in Model.Stock.Keys)
{
    <div class="row mb-2">
        <div class="col-2 fw-bold">@size</div>
        <div class="col-4">
            <input type="number"
                   name="Stock[@size]"
                   value="@Model.Stock[size]"
                   min="0"
                   class="form-control" />
        </div>
    </div>
}

<button type="submit" class="btn btn-primary">Save</button>

